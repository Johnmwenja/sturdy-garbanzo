#include <stdio.h>
#include <stdlib.h>

#define MAX_LENGTH 100

// Function to write a sentence to the file
void writeSentence() {
    FILE *file = fopen("data.txt", "w");
    if (file == NULL) {
        perror("Error opening file for writing");
        return;
    }

    char sentence[MAX_LENGTH];
    printf("Enter a sentence (up to 100 characters): ");
    getchar();  // Clear the newline left by previous input
    fgets(sentence, MAX_LENGTH, stdin);

    fprintf(file, "%s", sentence);
    fclose(file);
    printf("Sentence written to data.txt\n");
}

// Function to read the content of the file and display it
void readFile() {
    FILE *file = fopen("data.txt", "r");
    if (file == NULL) {
        perror("Error opening file for reading");
        return;
    }

    char ch;
    printf("Content of data.txt:\n");
    while ((ch = fgetc(file)) != EOF) {
        putchar(ch);
    }
    fclose(file);
}

// Function to append a sentence to the file
void appendSentence() {
    FILE *file = fopen("data.txt", "a");
    if (file == NULL) {
        perror("Error opening file for appending");
        return;
    }

    char sentence[MAX_LENGTH];
    printf("Enter a second sentence (up to 100 characters): ");
    getchar();  // Clear the newline left by previous input
    fgets(sentence, MAX_LENGTH, stdin);

    fprintf(file, "%s", sentence);
    fclose(file);
    printf("Second sentence appended to data.txt\n");
}

int main() {
    int choice;

    do {
        printf("\nMenu:\n");
        printf("1. Write a sentence to the file\n");
        printf("2. Read content from the file\n");
        printf("3. Append a sentence to the file\n");
        printf("4. Exit\n");
        printf("Choose an option: ");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                writeSentence();
                break;
            case 2:
                readFile();
                break;
            case 3:
                appendSentence();
                break;
            case 4:
                printf("Exiting the program.\n");
                break;
            default:
                printf("Invalid choice. Please try again.\n");
        }
    } while (choice != 4);

    return 0;
}
